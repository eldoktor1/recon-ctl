# Secrets
.recon_es_pass
.recon_discord*
.recon_mode
*.env
.env

# Local tooling / editor cruft (not pipeline code)
# Ignore .claude/* (local settings, worktrees) but TRACK the slash-commands —
# /hunt et al. are versioned pipeline doctrine, not local cruft.
.claude/*
!.claude/commands/
*.code-workspace
.tmp

# Runtime state
recon/state/
recon/cache/
recon/logs/
recon/triage/
recon/archive/
recon/spool/
recon/runs/

# Artifacts
*.lock
*.pid
*.epoch
*.jsonl
httpx_chunks/
httpx_parts/

# OS noise
.DS_Store
Thumbs.db
*.swp
*~
*:Zone.Identifier
*Zone.Identifier

# recon recovery/runtime safety
.recovery_backups/
recon_recovery_pack/
*.log
*.pid
*.lock
tools/__pycache__/
scripts/__pycache__/
engine/__pycache__/

# github-subdomains / scanner stray outputs in repo root
/*.txt

# local scratch / desktop-app artifacts (never mirror personal notes or attachment caches)
/IDEA.md
.hermes/

# recon-audit runtime reports (regenerated every run / every 6h by the daemon).
# The machine-readable source of truth is ~/recon/state/selfaudit_latest.json (outside
# the repo). The tracked manual deep-audit (docs/audit_2026-06-11.md) stays tracked;
# a new manual audit, if ever desired, can be force-added.
/docs/audit_20*.md
/docs/selfaudit_fixprompt_*.md
.mcp.json

# recon-ui build artifacts + local state (code is tracked; these are not)
/ui/frontend/node_modules
/ui/frontend/dist
/ui/backend/.venv
/ui/backend/**/__pycache__

# Claude Code local settings (machine-specific: permission allowlist, MCP approvals)
.claude/settings.local.json
