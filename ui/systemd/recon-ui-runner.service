[Unit]
Description=recon-ui hunt runner (executes lane jobs for the sandboxed UI)
Documentation=https://github.com/eldoktor1/recon-ctl
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/d0k/recon-ctl
# Daemon-equivalent environment so lanes behave exactly as in the daemon. This
# service is intentionally NOT sandboxed: target lanes sudo -> reconrun, which
# NoNewPrivileges/cap-drop would block. Escalation is bounded by the reconrun
# sudoers policy (the same whitelisted recon scripts the daemon runs), and this
# process is NOT network-facing — it only consumes the local job spool.
Environment=HOME=/home/d0k
Environment=PATH=/home/d0k/.local/bin:/home/d0k/go/bin:/home/d0k/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ES_URL=http://127.0.0.1:9200
Environment=INDEX_NAME=recon_alive
Environment=SCANNER_USER=reconrun
ExecStart=/home/d0k/recon-ctl/ui/backend/.venv/bin/python -m ui.backend.hunt_runner
Restart=always
RestartSec=5
KillMode=mixed
MemoryAccounting=yes
MemoryMax=8G
Nice=10

[Install]
WantedBy=default.target
