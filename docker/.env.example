# Copy this file to docker/.env and fill in your passwords before running docker compose.
#
#   cp docker/.env.example docker/.env
#   $EDITOR docker/.env
#   docker compose -f docker/docker-compose.yml up -d

# Elasticsearch superuser password (used by the pipeline to index and query results).
# Generate with: openssl rand -base64 24
ELASTIC_PASSWORD=changeme

# Kibana system user password (must be set in Elasticsearch before Kibana starts).
# Generate with: openssl rand -base64 24
KIBANA_PASSWORD=changeme

# JVM heap for Elasticsearch.  Set both values to half of available RAM, up to 32 GB.
# 2g is a safe default for a machine with 8 GB RAM.
ES_JAVA_OPTS=-Xms2g -Xmx2g
